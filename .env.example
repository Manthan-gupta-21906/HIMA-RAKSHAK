# ==============================================================================
# HIMA-RAKSHAK Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=HIMA-RAKSHAK
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL / PostGIS Database Credentials (required)
POSTGRES_USER=hima_user
POSTGRES_PASSWORD=
POSTGRES_DB=hima_rakshak
POSTGRES_PORT=5432

# Database Connection URL (PostgreSQL + PostGIS via psycopg 3 driver)
# - For Docker Compose (service-to-service inside Docker network): host is 'db'
# DATABASE_URL=postgresql+psycopg://hima_user:<POSTGRES_PASSWORD>@db:5432/hima_rakshak

# - For host-local development (running backend outside Docker connecting to exposed db container):
# DATABASE_URL=postgresql+psycopg://hima_user:<POSTGRES_PASSWORD>@localhost:5432/hima_rakshak

# - For local tests / fallback (SQLite):
# DATABASE_URL=sqlite:///./hima_rakshak.db

# Authentication / Security (required — set a unique 32+ char random secret in .env)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional development/test demo seed accounts (only read when APP_ENV is development or test)
# DEMO_ADMIN_USERNAME=Admin
# DEMO_ADMIN_PASSWORD=
# DEMO_OPERATOR_USERNAME=operator
# DEMO_OPERATOR_PASSWORD=
# DEMO_VIEWER_USERNAME=viewer
# DEMO_VIEWER_PASSWORD=

# Frontend Configuration
# Browser client endpoint pointing to the backend API
VITE_API_BASE_URL=http://localhost:8000
