# ==============================================================================
# HIMA-RAKSHAK Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=HIMA-RAKSHAK
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL / PostGIS Database Credentials
POSTGRES_USER=hima_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=hima_rakshak
POSTGRES_PORT=5432

# Database Connection URL (PostgreSQL + PostGIS via psycopg 3 driver)
# - For Docker Compose (service-to-service inside Docker network): host is 'db'
DATABASE_URL=postgresql+psycopg://hima_user:change_me_local_only@db:5432/hima_rakshak

# - For host-local development (running backend outside Docker connecting to exposed db container):
# DATABASE_URL=postgresql+psycopg://hima_user:change_me_local_only@localhost:5432/hima_rakshak

# - For local tests / fallback (SQLite):
# DATABASE_URL=sqlite:///./hima_rakshak.db

# Authentication / Security (override in local .env; never commit production secrets)
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Configuration
# Browser client endpoint pointing to the backend API
VITE_API_BASE_URL=http://localhost:8000
