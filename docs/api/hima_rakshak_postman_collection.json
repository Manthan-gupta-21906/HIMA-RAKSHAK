            "url": {
              "raw": "{{baseUrl}}/sources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sources"
              ]
            },
            "description": "List all telemetry and data sources with computed freshness status."
          }
        },
        {
          "name": "Get Source by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{viewerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sources/src-cwc-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sources",
                "src-cwc-01"
              ]
            },
            "description": "Retrieve specific data source contract and provenance metadata."
          }
        },
        {
          "name": "Register New Source (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_id\": \"src-imd-sgr-aws\",\n  \"source_name\": \"IMD Srinagar Automated Weather Station\",\n  \"provider\": \"India Meteorological Department (IMD)\",\n  \"dataset\": \"surface_synoptic_telemetry\",\n  \"source_type\": \"weather\",\n  \"access_mode\": \"live\",\n  \"licence\": \"Government Open Data Licence - India (GODL)\",\n  \"reference_url\": \"https://mausam.imd.gov.in/\",\n  \"update_frequency_minutes\": 30,\n  \"trust_classification\": \"authoritative\",\n  \"is_authoritative\": true,\n  \"is_demo_fixture\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sources"
              ]
            },
            "description": "Register an upstream data source with cadence and trust classification. Admin only."
          }
        },
        {
          "name": "Record Source Fetch Event (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sources/src-cwc-01/fetch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sources",
                "src-cwc-01",
                "fetch"
              ]
            },
            "description": "Record data ingestion from a source, updating its last_fetched_at timestamp and freshness."
          }
        }
      ]
    },
    {
